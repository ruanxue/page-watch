# GitHub Actions publishes this x86-64 image after every push to main.
# Replace both placeholders with your GitHub owner and repository name.
PAGE_WATCH_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/YOUR_REPOSITORY:stable

# This Docker network must contain the MySQL service. Jellyfin/qBittorrent can
# be reached through the NAS LAN and do not need to be started during install.
PAGE_WATCH_NETWORK=page-watch-backend
PAGE_WATCH_PORT=3030

# Use true only when Page Watch is accessed through an HTTPS reverse proxy.
APP_SESSION_SECURE=false

# MySQL is configured in the first-run web guide and saved encrypted under
# ../data. Leave these blank for a new deployment. Keeping filled values is
# supported for legacy deployments, but then Docker manages the connection.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=3

# Optional advanced override. Leave blank for personal deployments: Page Watch
# generates a random key once in ../data/app-encryption-key and reuses it on
# every update. Set a 32-byte Base64URL value only when you manage the key.
APP_ENCRYPTION_KEY=

# Leave blank when the NAS can access target sites directly. Never use the
# development computer's 127.0.0.1 proxy address here.
OUTBOUND_PROXY=
