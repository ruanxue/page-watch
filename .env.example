PORT=3030
PLAYWRIGHT_HEADLESS=true
OUTBOUND_PROXY=
PLAYWRIGHT_EXECUTABLE_PATH=
APP_SESSION_SECURE=false


# 留空则在网页安装引导中填写。仅支持 PostgreSQL。
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# 单容器内网页服务与执行引擎各自的连接上限；通常保持 3 即可。
DATABASE_CONNECTION_LIMIT=3

# 执行引擎空闲内存回收阈值（MB）。默认 160；小内存机器可调低，性能模式或大内存机器可调高（有效范围 64-4096）。
ENGINE_MEMORY_RECYCLE_THRESHOLD_MB=160
# 网页服务进程内存告警阈值（MB）。默认 256；只记录日志，不会重启网页服务（有效范围 64-4096）。
APP_MEMORY_GUARD_MB=256

# 部署在反向代理（Nginx / NAS 网关）后面时设为 true，让登录限流取到真实客户端 IP。
# 直接暴露端口时必须保持 false，否则攻击者可以伪造 X-Forwarded-For 绕过限流。
APP_TRUST_PROXY=false
