{
  "name": "page-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "tsx server/worker.ts",
    "dev:release-worker": "tsx server/release-worker.ts",
    "dev:magnet-worker": "tsx server/magnet-worker.ts",
    "dev:download-worker": "tsx server/download-worker.ts",
    "dev:library-worker": "tsx server/library-worker.ts",
    "dev:runner": "tsx server/runner.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "vite build",
    "test": "node --import tsx --test server/*.test.ts",
    "test:postgres": "node --import tsx --test --test-concurrency=1 server/integration/*.test.ts",
    "all-in-one": "tsx server/all-in-one.ts",
    "start:production": "node build/server/index.js",
    "start": "tsx server/index.ts",
    "worker": "tsx server/worker.ts",
    "release-worker": "tsx server/release-worker.ts",
    "magnet-worker": "tsx server/magnet-worker.ts",
    "download-worker": "tsx server/download-worker.ts",
    "library-worker": "tsx server/library-worker.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/static": "^10.1.6",
    "cheerio": "^1.1.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "pg": "^8.23.1",
    "playwright": "1.63.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.7"
  }
}
